---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'size-6' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<img src={`${base}/images/${name}.svg`} alt="" width="24" height="24" class:list={['shrink-0 object-contain', className]} aria-hidden="true" />
