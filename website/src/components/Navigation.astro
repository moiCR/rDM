---
import PlatformIcon from './PlatformIcon.astro';
import { repository } from '../data/downloads';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="page-width grid h-24 grid-cols-[1fr_auto_1fr] items-center md:h-28">
  <a class="w-fit" href="#" aria-label="Rust Download Manager home">
    <img src={`${base}/images/app-icon.png`} alt="Rust Download Manager" width="48" height="48" class="size-10 object-contain md:size-12" />
  </a>
  <nav aria-label="Main navigation" class="flex gap-5 rounded-full border border-border bg-surface px-5 py-3 text-xs md:gap-8 md:px-7 md:py-3.5 md:text-sm">
    <a class="transition-colors hover:text-primary-text" href="#download">Download</a>
    <a class="transition-colors hover:text-primary-text" href="#extensions">Extensions</a>
  </nav>
  <a class="justify-self-end opacity-75 transition-opacity hover:opacity-100" href={repository} aria-label="Rust Download Manager on GitHub"><PlatformIcon name="github" class="size-5 invert md:size-6" /></a>
</header>
