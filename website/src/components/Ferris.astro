---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="ferris-scene" aria-hidden="true">
  <div class="ferris-orbit"></div>
  <div class="ferris-orbit ferris-orbit-secondary"></div>
  <div class="ferris-shadow"></div>
  <img class="ferris" src={`${base}/images/ferris.svg`} alt="" width="700" height="470" fetchpriority="high" />
</div>
